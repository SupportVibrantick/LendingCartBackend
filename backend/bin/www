const { validateApiEnv, isEmailEnabled, isPrimaryProcess, isProduction } = require("../config/env");
const { getConfiguredStorageProviderSync } = require("../services/storage/config");
const { startEmailOutboxWorker } = require("../services/email");
const { registerProcessSafetyHandlers } = require("../config/processSafety");

registerProcessSafetyHandlers("api");

try {
  validateApiEnv();
} catch (error) {
  console.error("API environment validation failed:", error.message);
  process.exit(1);
}


const app = require("../app");
const debug = require("debug")("backend:server");

function normalizePort(val) {
  const port = parseInt(val, 10);

  if (isNaN(port)) {
    return val;
  }

  if (port >= 0) {
    return port;
  }

  return false;
}

const port = normalizePort(process.env.PORT || "3002");

async function start() {
  const address = await app.listen({ port, host: "0.0.0.0" });

  const bind = typeof port === "string" ? "Pipe " + port : "Port " + port;
  console.log(`Server is running on ${address}`);
  debug(`Server is running on ${address}`);
  app.log.info(`Server listening on ${bind}`);

  if (isProduction()) {
    const storageProvider = getConfiguredStorageProviderSync();
    if (storageProvider === "local") {
      app.log.warn(
        "Production uploads are on local disk. Set STORAGE_PROVIDER=s3 (and S3 credentials) so files are shared across API processes and survive deploys. Existing /uploads files on disk are still served.",
      );
    } else {
      app.log.info("Production uploads use S3. Existing local /uploads files are still served.");
    }
  }

  // The dedicated worker also drains the outbox. Only the first API process
  // does too, so a 2–4 process cluster does not poll the table on every worker.
  if (isEmailEnabled() && isPrimaryProcess()) {
    startEmailOutboxWorker(app.prisma);
    app.log.info("Email outbox worker started (API process)");
  }
}

start().catch((err) => {
  console.error("Error starting API server:", err);
  if (err?.code) {
    console.error("Startup error code:", err.code);
  }
  if (err?.cause) {
    console.error("Startup error cause:", err.cause);
  }
  process.exit(1);
});
