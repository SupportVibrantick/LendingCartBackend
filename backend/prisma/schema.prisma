generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                          String                     @id @default(uuid()) @db.Uuid
  name                        String
  type                        OrganizationType
  status                      OrganizationStatus
  email                       String?
  phone                       String?
  createdAt                   DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                   @updatedAt @db.Timestamptz(6)
  isDeleted                   Boolean?                   @default(false) @map("is_deleted")
  deletedAt                   DateTime?                  @map("deleted_at") @db.Timestamptz(6)
  affiliateLinks              AffiliateLink[]
  publicApplicationLinks      PublicApplicationLink[]
  lenderApplications          ApplicationLender[]        @relation("LenderApplications")
  auditLogsAsActorOrg         AuditLog[]                 @relation("OrgAuditLogs")
  brokerApplications          BrokerApplication[]
  brokerLenderAccessAsBroker  BrokerLenderAccess[]       @relation("BrokerAccess_broker")
  brokerLenderAccessAsLender  BrokerLenderAccess[]       @relation("BrokerAccess_lender")
  brokerLenderInvitesAsBroker BrokerLenderInvite[]       @relation("BrokerInvite_broker")
  brokerLenderInvitesAsLender BrokerLenderInvite[]       @relation("BrokerInvite_lender")
  brokerWhiteLabelSettings    BrokerWhiteLabelSetting?
  campaigns                   Campaign[]                 @relation("OrgCampaigns")
  clients                     Client[]                   @relation("BrokerClients")
  contacts                    Contact[]
  documentReminderSchedules   DocumentReminderSchedule[]
  escrowTitleCompanies        EscrowTitleCompany[]
  feeAgreements               FeeAgreement[]             @relation("OrgToFeeAgreement")
  loiTemplates                LenderLoiTemplate?
  lenderBrandingSettings      LenderBrandingSetting?
  lenderProducts              LenderProduct[]
  lenderProfile               LenderProfile?
  loanAiUsers                 LoanAiUser?
  brokerLoanApplications      LoanApplication[]          @relation("BrokerLoanApplications")
  dealCommissions             DealCommission[]
  commissionInvoices          CommissionInvoice[]
  commissionPayouts           CommissionPayout[]
  commissionAuditEvents       CommissionAuditEvent[]
  organizationSubscriptions   OrganizationSubscription[]
  subscriptionInvoices        SubscriptionInvoice[]
  users                       UserAccount[]
  adminLenderInvites          AdminLenderInvite[]
  ghlConnection               OrganizationGhlConnection?
  /// Platform-owned Agency Pro/Elite location mapping (separate from broker OAuth).
  ghlAgencyLocation           OrganizationGhlAgencyLocation?
  /// LC user ↔ Agency GHL team-user mappings (read-only reconciliation foundation).
  ghlAgencyUsers              OrganizationGhlAgencyUser[]
  signFormDefinitions         SignFormDefinition[]
  signFormLibraryTemplates    SignFormLibraryTemplate[]

  @@map("organizations")
}

model AdminLenderInvite {
  id               String                   @id @default(uuid()) @db.Uuid
  companyName      String                   @map("company_name")
  fullName         String                   @map("full_name")
  email            String
  phone            String?
  token            String                   @unique
  status           AdminLenderInviteStatus  @default(PENDING)
  expiresAt        DateTime                 @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?                @map("accepted_at") @db.Timestamptz(6)
  declinedAt       DateTime?                @map("declined_at") @db.Timestamptz(6)
  cancelledAt      DateTime?                @map("cancelled_at") @db.Timestamptz(6)
  lastSentAt       DateTime                 @default(now()) @map("last_sent_at") @db.Timestamptz(6)
  invitedByAdminId String?                  @map("invited_by_admin_id") @db.Uuid
  invitedByBrokerOrgId String?              @map("invited_by_broker_org_id") @db.Uuid
  invitedByBrokerUserId String?             @map("invited_by_broker_user_id") @db.Uuid
  notes              String?
  tokenUsedAt        DateTime?              @map("token_used_at") @db.Timestamptz(6)
  inviteSource       LenderInviteSource     @default(ADMIN) @map("invite_source")
  lenderOrgId      String?                  @map("lender_org_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  lenderOrg        Organization?            @relation(fields: [lenderOrgId], references: [id])

  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@map("admin_lender_invites")
}

model UserAccount {
  id                            String                           @id @default(uuid()) @db.Uuid
  organizationId                String?                          @db.Uuid
  email                         String                           @unique
  passwordHash                  String
  firstName                     String?
  lastName                      String?
  phone                         String?
  profileImage                  String?                          @map("profile_image")
  status                        UserStatus                       @default(ACTIVE)
  lastLoginAt                   DateTime?                        @db.Timestamptz(6)
  createdAt                     DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime                         @updatedAt @db.Timestamptz(6)
  createdById                   String?                          @db.Uuid
  isDeleted                     Boolean?                         @default(false) @map("is_deleted")
  deletedAt                     DateTime?                        @map("deleted_at") @db.Timestamptz(6)
  createdConversations          Conversation[]
  reviewedSubBrokerDocs         SubBrokerSubmission[]            @relation("SubBrokerSubmissionReviewedBy")
  submittedSubBrokerDocs        SubBrokerSubmission[]            @relation("SubBrokerSubmissionSubmittedBy")
  requestedDocumentRequirements ApplicationDocumentRequirement[] @relation("DocumentRequirementRequestedBySubBroker")
  uploadedDocs                  ApplicationDocumentUpload[]      @relation("UploadedByUser")
  applicationSent               ApplicationLender[]              @relation("SentByUser")
  changedApplicationStatuses    ApplicationStatusHistory[]       @relation("ChangedByUser")
  applicationTemplates          ApplicationTemplate[]
  auditLogs                     AuditLog[]                       @relation("UserAuditLogs")
  fundedApplications            LoanApplication[]                @relation("FundedByUser")
  dealCommissionsReceived       DealCommission[]                 @relation("CommissionRecipient")
  commissionInvoicesGenerated   CommissionInvoice[]              @relation("CommissionInvoiceGeneratedBy")
  commissionPayoutsRecorded     CommissionPayout[]               @relation("CommissionPayoutRecordedBy")
  commissionAuditEvents         CommissionAuditEvent[]           @relation("CommissionAuditActor")
  brokerProfile                 BrokerUserProfile?
  campaigns                     Campaign[]                       @relation("UserCampaigns")
  createdContacts               Contact[]
  documentReminderSchedules     DocumentReminderSchedule[]       @relation("ReminderCreatedBy")
  createdEscrowInstructions     EscrowInstruction[]              @relation("CreatedEscrowInstructions")
  lenderReviews                 LenderReview[]                   @relation("ReviewedByUser")
  brokerLoanApplications        LoanApplication[]                @relation("BrokerUserLoanApplications")
  publicApplicationLinksCreated PublicApplicationLink[]          @relation("PublicApplicationLinkCreatedBy")
  publicApplicationLinksAsLoanOfficer PublicApplicationLink[]    @relation("PublicApplicationLinkLoanOfficer")
  publicApplicationLinksAsCoBroker PublicApplicationLink[]       @relation("PublicApplicationLinkCoBroker")
  publicApplicationsCreated     LoanApplication[]                @relation("PublicApplicationCreatedBy")
  passwordResetTokens           PasswordResetToken[]
  emailVerificationTokens       EmailVerificationToken[]
  emailVerifiedAt               DateTime?                        @map("email_verified_at") @db.Timestamptz(6)
  assignedSubBrokerApplications SubBrokerApplication[]           @relation("SubBrokerAssignedBy")
  assignedApplications          SubBrokerApplication[]           @relation("SubBrokerAssignedApplications")
  loanOfficerSubBrokers         SubBrokerLoanOfficer[]           @relation("LoanOfficerSubBrokerLinks")
  subBrokerLoanOfficers         SubBrokerLoanOfficer[]           @relation("SubBrokerAssignedLoanOfficers")
  subBrokerProfile              SubBrokerProfile?
  createdBy                     UserAccount?                     @relation("CreatedSubBrokers", fields: [createdById], references: [id])
  createdSubBrokers             UserAccount[]                    @relation("CreatedSubBrokers")
  organization                  Organization?                    @relation(fields: [organizationId], references: [id])
  userPermissions               UserPermission[]
  roles                         UserRole[]
  lenderLoiVersionsGenerated    LenderLoiVersion[]               @relation("LenderLoiVersionGeneratedBy")
  brokerLoiVersionsGenerated    BrokerLoiVersion[]               @relation("BrokerLoiVersionGeneratedBy")
  ghlConnectionsConnected       OrganizationGhlConnection[]      @relation("GhlConnectionConnectedBy")
  ghlAgencyUserMapping          OrganizationGhlAgencyUser?
  signFormVersionsPublished     SignFormVersion[]                @relation("SignFormVersionPublishedBy")
  signFormSubmissionValues      SignFormSubmissionValue[]        @relation("SignFormValueFilledByUser")
  signFormLibraryTemplatesCreated SignFormLibraryTemplate[]      @relation("SignFormLibraryTemplateCreatedBy")

  @@map("user_accounts")
}

model PasswordResetToken {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  token     String      @unique
  expiresAt DateTime    @db.Timestamptz(6)
  usedAt    DateTime?   @db.Timestamptz(6)
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  token     String      @unique
  expiresAt DateTime    @db.Timestamptz(6)
  usedAt    DateTime?   @db.Timestamptz(6)
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  user      UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("email_verification_tokens")
}

model LoanAiUser {
  id                       String                    @id @default(uuid()) @db.Uuid
  email                    String                    @unique
  passwordHash             String
  firstName                String?
  lastName                 String?
  brokerOrganizationId     String?                   @unique @db.Uuid
  lastLoginAt              DateTime?                 @db.Timestamptz(6)
  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)
  brokerOrganization       Organization?             @relation(fields: [brokerOrganizationId], references: [id])
  ghlCheckouts             LoanAiGhlCheckout[]
  organizationSubscriptions OrganizationSubscription[]

  @@map("loan_ai_users")
}

/// Pending / completed GHL payment checkouts for Loan AI users.
/// Checkout/session layer — live entitlement lives on OrganizationSubscription.
model LoanAiGhlCheckout {
  id                         String                   @id @default(uuid()) @db.Uuid
  loanAiUserId               String                   @db.Uuid
  packageId                  String                   @db.Uuid
  billingCycle               SubscriptionBillingCycle
  status                     LoanAiGhlCheckoutStatus  @default(PENDING)
  paymentStatus              GhlPaymentStatus         @default(PENDING)
  amount                     Decimal                  @db.Decimal(10, 2)
  currency                   String                   @default("USD")
  ghlContactId               String?
  ghlProductId               String?
  ghlPriceId                 String
  ghlInvoiceId               String?
  ghlSubscriptionId          String?
  checkoutUrl                String?
  successUrl                 String?
  cancelUrl                  String?
  lastError                  String?
  metadata                   Json?
  currentPeriodStart         DateTime?                @db.Timestamptz(6)
  currentPeriodEnd           DateTime?                @db.Timestamptz(6)
  cancelledAt                DateTime?                @db.Timestamptz(6)
  expiresAt                  DateTime?                @db.Timestamptz(6)
  completedAt                DateTime?                @db.Timestamptz(6)
  organizationSubscriptionId String?                  @unique @db.Uuid
  createdAt                  DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                 @updatedAt @db.Timestamptz(6)
  loanAiUser                 LoanAiUser               @relation(fields: [loanAiUserId], references: [id], onDelete: Cascade)
  package                    SubscriptionPackage      @relation(fields: [packageId], references: [id])
  organizationSubscription   OrganizationSubscription? @relation(fields: [organizationSubscriptionId], references: [id])

  @@index([loanAiUserId])
  @@index([packageId])
  @@index([status])
  @@index([paymentStatus])
  @@index([ghlInvoiceId])
  @@index([ghlContactId])
  @@index([ghlSubscriptionId])
  @@map("loan_ai_ghl_checkouts")
}

model BrokerUserProfile {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @unique @db.Uuid
  company         String?
  tollFree        String?
  tollFreeExt     String?
  serviceProvider String?
  address         String?
  suite           String?
  city            String?
  state           String?
  zipCode         String?
  agentType       String?
  licenseNumber   String?
  preferredComm   String?
  website         String?
  avatarUrl       String?
  w9Url           String?
  profileData     Json?
  createdAt       DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(6)
  user            UserAccount @relation(fields: [userId], references: [id])

  @@map("broker_user_profiles")
}

model SubBrokerApplication {
  id                String          @id @default(uuid()) @db.Uuid
  loanApplicationId String          @db.Uuid
  subBrokerId       String          @db.Uuid
  assignedById      String?         @db.Uuid
  assignedAt        DateTime        @default(now()) @db.Timestamptz(6)
  assignedBy        UserAccount?    @relation("SubBrokerAssignedBy", fields: [assignedById], references: [id])
  loanApplication   LoanApplication @relation(fields: [loanApplicationId], references: [id])
  subBroker         UserAccount     @relation("SubBrokerAssignedApplications", fields: [subBrokerId], references: [id])

  @@unique([loanApplicationId, subBrokerId])
  @@index([loanApplicationId])
  @@index([subBrokerId])
  @@map("sub_broker_applications")
}

model SubBrokerProfile {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @unique @db.Uuid
  profileData Json?
  logoUrl     String?
  w9Url       String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  user        UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sub_broker_profiles")
}

model SubBrokerLoanOfficer {
  id            String      @id @default(uuid()) @db.Uuid
  subBrokerId   String      @db.Uuid
  loanOfficerId String      @db.Uuid
  createdAt     DateTime    @default(now()) @db.Timestamptz(6)
  loanOfficer   UserAccount @relation("LoanOfficerSubBrokerLinks", fields: [loanOfficerId], references: [id], onDelete: Cascade)
  subBroker     UserAccount @relation("SubBrokerAssignedLoanOfficers", fields: [subBrokerId], references: [id], onDelete: Cascade)

  @@unique([subBrokerId, loanOfficerId])
  @@index([subBrokerId])
  @@index([loanOfficerId])
  @@map("sub_broker_loan_officers")
}

model LenderProfile {
  id                   String              @id @default(uuid()) @db.Uuid
  lenderOrgId          String              @unique @db.Uuid
  summary              String?
  loanTypes            LoanProductCode[]
  minFunding           Decimal?            @db.Decimal(20, 2)
  maxFunding           Decimal?            @db.Decimal(20, 2)
  statesSupported      String?
  industries           String?
  fundingSpeedDays     Int?
  profileStatus        LenderProfileStatus @default(DRAFT)
  isVisible            Boolean             @default(false)
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(6)
  lendingCriteria      String?
  lendingGuidelines    String?
  creditRequirements   String?
  propertyRequirements String?
  website              String?
  nmls                 String?
  address              String?
  city                 String?
  state                String?
  zip                  String?
  lenderType           String?
  submittedByBrokerOrgId String?            @map("submitted_by_broker_org_id") @db.Uuid
  lender               Organization        @relation(fields: [lenderOrgId], references: [id])

  @@map("lender_profiles")
}

model LenderBrandingSetting {
  id          String       @id @default(uuid()) @db.Uuid
  lenderOrgId String       @unique @db.Uuid
  brandName   String?
  logoUrl     String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  lender      Organization @relation(fields: [lenderOrgId], references: [id])

  @@index([lenderOrgId])
  @@map("lender_branding_settings")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            RoleName
  description     String?
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model UserRole {
  id     String      @id @default(uuid()) @db.Uuid
  userId String      @db.Uuid
  roleId String      @db.Uuid
  role   Role        @relation(fields: [roleId], references: [id])
  user   UserAccount @relation(fields: [userId], references: [id])

  @@map("user_roles")
}

model Client {
  id                 String              @id @default(uuid()) @db.Uuid
  primaryBrokerOrgId String              @db.Uuid
  legalName          String
  entityType         ClientEntityType
  taxId              String?
  industry           String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)
  isDeleted          Boolean?            @default(false) @map("is_deleted")
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(6)
  uploadTokens       ClientUploadToken[]
  contacts           ClientContact[]
  portalUsers        ClientPortalUser[]
  primaryBroker      Organization        @relation("BrokerClients", fields: [primaryBrokerOrgId], references: [id])
  feeAgreements      FeeAgreement[]      @relation("ClientToFeeAgreement")
  loanApplications   LoanApplication[]

  @@map("clients")
}

model ClientContact {
  id        String  @id @default(uuid()) @db.Uuid
  clientId  String  @db.Uuid
  firstName String
  lastName  String?
  email     String
  phone     String?
  role      String?
  isPrimary Boolean @default(false)
  client    Client  @relation(fields: [clientId], references: [id])

  @@map("client_contacts")
}

model ClientPortalUser {
  id           String                      @id @default(uuid()) @db.Uuid
  clientId     String                      @db.Uuid
  email        String                      @unique
  passwordHash String
  isActive     Boolean                     @default(true)
  createdAt    DateTime                    @default(now()) @db.Timestamptz(6)
  lastLoginAt  DateTime?                   @db.Timestamptz(6)
  isDeleted    Boolean?                    @default(false) @map("is_deleted")
  deletedAt    DateTime?                   @map("deleted_at") @db.Timestamptz(6)
  uploadedDocs         ApplicationDocumentUpload[] @relation("UploadedByClient")
  signFormSubmissions  SignFormSubmission[]        @relation("SignFormSubmittedByClient")
  client               Client                      @relation(fields: [clientId], references: [id])

  @@map("client_portal_users")
}

model LoanProduct {
  id                          String                       @id @default(uuid()) @db.Uuid
  code                        LoanProductCode
  name                        String
  description                 String?
  isActive                    Boolean                      @default(true)
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                     @updatedAt @db.Timestamptz(6)
  lenderProducts              LenderProduct[]
  productDocumentRequirements ProductDocumentRequirement[]

  @@map("loan_products")
}

model LenderProduct {
  id                          String                      @id @default(uuid()) @db.Uuid
  lenderOrgId                 String                      @db.Uuid
  loanProductId               String?                     @db.Uuid
  loanProductCode             LoanProductCode
  businessTypes               Json?
  propertyTypes               Json?
  equipmentTypes              String?
  otherEquipmentExplanation   String?
  minLoanAmount               Decimal?                    @db.Decimal(20, 2)
  maxLoanAmount               Decimal?                    @db.Decimal(20, 2)
  minTermMonths               Int?
  maxTermMonths               Int?
  maxLtvPercent               Decimal?                    @db.Decimal(5, 2)
  minCreditScore              Int?
  minExperience               String?
  interestRateRange           String?
  statesSupported             String?
  isActive                    Boolean                     @default(true)
  createdAt                   DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                    @updatedAt @db.Timestamptz(6)
  maxArvPercent               Decimal?                    @db.Decimal(5, 2)
  maxLtcPercent               Decimal?                    @db.Decimal(5, 2)
  minMezzLtvPercent           Decimal?                    @db.Decimal(5, 2)
  maxMezzLtvPercent           Decimal?                    @db.Decimal(5, 2)
  exitFeePercent              Decimal?                    @db.Decimal(5, 2)
  preferredReturnPercent      Decimal?                    @db.Decimal(5, 2)
  originationPointsPercent    Decimal?                    @db.Decimal(5, 2)
  extensionAvailable          Boolean?                    @default(false)
  personalGuaranteeRequired   Boolean?                    @default(false)
  firstTimeBorrowersAllowed   Boolean?                    @default(false)
  minDscr                     Decimal?                    @db.Decimal(5, 2)
  minDebtYieldPercent         Decimal?                    @db.Decimal(5, 2)
  amortizationYears           Int?
  minUnits                    Int?
  prepaymentStructure         String?
  minPropertiesInPortfolio    Int?
  maxPropertiesInPortfolio    Int?
  interestOnlyAvailable       Boolean?                    @default(false)
  shortTermRentalsOk          Boolean?                    @default(false)
  foreignNationalsAllowed     Boolean?                    @default(false)
  gcRequired                  Boolean?                    @default(false)
  completionGuaranteeRequired Boolean?                    @default(false)
  criteriaNotes               String?
  maxRateSpreadPercent        Decimal?                    @db.Decimal(5, 2)
  minRateSpreadPercent        Decimal?                    @db.Decimal(5, 2)
  sbaGuaranteePercent         Decimal?                    @db.Decimal(5, 2)
  minAnnualRevenue            Decimal?                    @db.Decimal(20, 2)
  startupAllowed              Boolean?                    @default(false)
  minLiquidityRequirement     String?
  ownerOccupancyRequirement   String?
  useOfFunds                  String?
  collateralRequirements      String?
  maxFinancingPercent         Decimal?                    @db.Decimal(5, 2)
  rateStructure               String?
  refinanceAllowed            Boolean?                    @default(false)
  workingCapitalEligible      Boolean?                    @default(false)
  lifeInsuranceMayBeRequired  Boolean?                    @default(false)
  environmentalReportRequired Boolean?                    @default(false)
  appraisalRequired           Boolean?                    @default(false)
  avgTurnaroundDays           Int?
  preferredLenderPlp          Boolean?                    @default(false)
  requiredInjectionPercent    Decimal?                    @db.Decimal(5, 2)
  goodwillFinancingAllowed    Boolean?                    @default(false)
  sellerFinancingAllowed      Boolean?                    @default(false)
  preferredDscr               Decimal?                    @db.Decimal(5, 2)
  maxTermRealEstateMonths     Int?
  intangibleAssetsAllowed     Boolean?                    @default(false)
  equipmentIncluded           Boolean?                    @default(false)
  realEstateIncluded          Boolean?                    @default(false)
  franchiseAcquisitionAllowed Boolean?                    @default(false)
  collateralRequired          Boolean?                    @default(false)
  collateralAsDownPaymentAllowed Boolean?                 @default(false)
  maxTermEquipmentMonths      Int?
  maximumDebtService          Decimal?                    @db.Decimal(20, 2)
  businessAcquisitionAllowed  Boolean?                    @default(false)
  equipmentPurchaseAllowed    Boolean?                    @default(false)
  businessCreditRequired      Boolean?                    @default(false)
  usOperatingBusinessRequired Boolean?                    @default(false)
  startupEligible             Boolean?                    @default(false)
  franchiseEligible           Boolean?                    @default(false)
  foreignOwnershipAllowed     Boolean?                    @default(false)
  bankruptcyAllowed           Boolean?                    @default(false)
  prepaymentPenalty           Boolean?                    @default(false)
  minTimeInBusinessMonths     Int?
  lineOfCreditAvailable       Boolean?                    @default(false)
  usedEquipmentAllowed        Boolean?                    @default(false)
  ownerOccupiedRequired       Boolean?                    @default(false)
  maxTotalProjectAmount       Decimal?                    @db.Decimal(15, 2)
  maxSba504DebentureAmount    Decimal?                    @db.Decimal(15, 2)
  jobCreationRequired         Boolean?                    @default(false)
  maxUsdaGuaranteeAmount      Decimal?                    @db.Decimal(15, 2)
  usdaGuaranteePercent        Decimal?                    @db.Decimal(5, 2)
  ruralAreaRequired           Boolean?                    @default(false)
  advanceRatePercent          Decimal?                    @db.Decimal(5, 2)
  transactionFeePercent       Decimal?                    @db.Decimal(5, 2)
  minGrossMarginPercent       Decimal?                    @db.Decimal(5, 2)
  internationalPosAllowed     Boolean?                    @default(false)
  saleLeasebackAvailable      Boolean?                    @default(false)
  discountFeePercent          Decimal?                    @db.Decimal(5, 2)
  maxInvoiceAgeDays           Int?
  nonRecourseAvailable        Boolean?                    @default(false)
  governmentInvoicesOk        Boolean?                    @default(false)
  earlyPaymentDiscountPercent Decimal?                    @db.Decimal(5, 2)
  paymentTermsExtensionDays   Int?
  dynamicDiscountingAvailable Boolean?                    @default(false)
  reverseFactoringAvailable   Boolean?                    @default(false)
  applicationLenders          ApplicationLender[]
  eligibilityRuleSets         EligibilityRuleSet[]
  lenderDocumentRequirements  LenderDocumentRequirement[]
  lender                      Organization                @relation(fields: [lenderOrgId], references: [id])
  loanProduct                 LoanProduct?                @relation(fields: [loanProductId], references: [id])

  @@unique([lenderOrgId, loanProductCode])
  @@index([lenderOrgId])
  @@index([loanProductCode])
  @@index([loanProductId])
  @@map("lender_products")
}

model BrokerLenderAccess {
  id            String             @id @default(uuid()) @db.Uuid
  brokerOrgId   String             @db.Uuid
  lenderOrgId   String             @db.Uuid
  source        BrokerLenderSource
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(6)
