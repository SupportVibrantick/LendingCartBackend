  FAILED
}

enum SignFormSubmissionStatus {
  DRAFT
  COMPLETE
}

enum SignFormFillRole {
  CLIENT
  BROKER
}

model SignFormDefinition {
  id             String                        @id @default(uuid()) @db.Uuid
  organizationId String                        @db.Uuid
  requirementId  String                        @unique @db.Uuid
  title          String
  status         SignFormStatus                @default(DRAFT)
  createdAt      DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                      @updatedAt @db.Timestamptz(6)
  organization   Organization                  @relation(fields: [organizationId], references: [id])
  requirement    ApplicationDocumentRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  versions       SignFormVersion[]

  @@index([organizationId])
  @@map("sign_form_definitions")
}

model SignFormVersion {
  id                 String                         @id @default(uuid()) @db.Uuid
  formDefinitionId   String                         @db.Uuid
  version            Int
  status             SignFormStatus                 @default(DRAFT)
  schemaJson         Json                           @map("schema_json")
  pageManifestJson   Json?                          @map("page_manifest_json")
  publishedAt        DateTime?                      @map("published_at") @db.Timestamptz(6)
  publishedByUserId  String?                        @map("published_by_user_id") @db.Uuid
  createdAt          DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                       @updatedAt @db.Timestamptz(6)
  formDefinition     SignFormDefinition             @relation(fields: [formDefinitionId], references: [id], onDelete: Cascade)
  publishedBy        UserAccount?                   @relation("SignFormVersionPublishedBy", fields: [publishedByUserId], references: [id])
  activeOnRequirements ApplicationDocumentRequirement[] @relation("RequirementActiveFormVersion")
  submissions        SignFormSubmission[]

  @@unique([formDefinitionId, version])
  @@index([formDefinitionId])
  @@index([status])
  @@map("sign_form_versions")
}

model SignFormSubmission {
  id                     String                     @id @default(uuid()) @db.Uuid
  requirementId          String                     @db.Uuid
  formVersionId          String                     @db.Uuid
  status                 SignFormSubmissionStatus   @default(DRAFT)
  submittedByClientUserId String?                   @map("submitted_by_client_user_id") @db.Uuid
  submittedAt            DateTime?                  @map("submitted_at") @db.Timestamptz(6)
  createdAt              DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                   @updatedAt @db.Timestamptz(6)
  requirement            ApplicationDocumentRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  formVersion            SignFormVersion            @relation(fields: [formVersionId], references: [id])
  submittedByClientUser  ClientPortalUser?          @relation("SignFormSubmittedByClient", fields: [submittedByClientUserId], references: [id])
  values                 SignFormSubmissionValue[]

  @@index([requirementId])
  @@index([formVersionId])
  @@index([status])
  @@map("sign_form_submissions")
}

model SignFormSubmissionValue {
  id              String            @id @default(uuid()) @db.Uuid
  submissionId    String            @db.Uuid
  fieldKey        String            @map("field_key")
  valueJson       Json              @map("value_json")
  filledByRole    SignFormFillRole  @map("filled_by_role")
  filledByUserId  String?           @map("filled_by_user_id") @db.Uuid
  filledAt        DateTime          @default(now()) @map("filled_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)
  submission      SignFormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  filledByUser    UserAccount?      @relation("SignFormValueFilledByUser", fields: [filledByUserId], references: [id])

  @@unique([submissionId, fieldKey])
  @@index([submissionId])
  @@index([fieldKey])
  @@map("sign_form_submission_values")
}

model SignFormLibraryTemplate {
  id                  String         @id @default(uuid()) @db.Uuid
  organizationId      String         @db.Uuid
  name                String
  description         String?
  status              SignFormStatus @default(PUBLISHED)
  templateFileName    String         @map("template_file_name")
  templateFileUrl     String         @map("template_file_url")
  templateMimeType    String?        @map("template_mime_type")
  schemaJson          Json           @map("schema_json")
  pageManifestJson    Json?          @map("page_manifest_json")
  sourceRequirementId String?        @map("source_requirement_id") @db.Uuid
  createdByUserId     String?        @map("created_by_user_id") @db.Uuid
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(6)
  organization        Organization   @relation(fields: [organizationId], references: [id])
  createdBy           UserAccount?   @relation("SignFormLibraryTemplateCreatedBy", fields: [createdByUserId], references: [id])

  @@index([organizationId, status])
  @@index([createdByUserId])
  @@map("sign_form_library_templates")
}

