model LenderProduct {
  id String @id @default(uuid()) @db.Uuid

  lenderOrgId     String          @db.Uuid
  loanProductId   String?         @db.Uuid
  loanProductCode LoanProductCode

  businessTypes Json?
  propertyTypes Json?

  equipmentTypes            String?
  otherEquipmentExplanation String?

  minLoanAmount Decimal? @db.Decimal(20, 2)
  maxLoanAmount Decimal? @db.Decimal(20, 2)

  minTermMonths Int?
  maxTermMonths Int?

  minLtvPercent Decimal? @db.Decimal(5, 2)
  maxLtvPercent Decimal? @db.Decimal(5, 2)

  minCreditScore Int?
  minExperience  String?

  interestRateRange String?

  statesSupported String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  applicationLenders         ApplicationLender[]
  eligibilityRuleSets        EligibilityRuleSet[]
  lenderDocumentRequirements LenderDocumentRequirement[]

  lender      Organization @relation(fields: [lenderOrgId], references: [id])
  loanProduct LoanProduct? @relation(fields: [loanProductId], references: [id])

  @@unique([lenderOrgId, loanProductCode])
  @@index([lenderOrgId])
  @@index([loanProductCode])
  @@index([loanProductId])
  @@map("lender_products")
}

model BrokerLenderAccess {
  id          String             @id @default(uuid()) @db.Uuid
  brokerOrgId String             @db.Uuid
  lenderOrgId String             @db.Uuid
  source      BrokerLenderSource
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  broker      Organization       @relation("BrokerAccess_broker", fields: [brokerOrgId], references: [id])
  lender      Organization       @relation("BrokerAccess_lender", fields: [lenderOrgId], references: [id])

  @@index([brokerOrgId])
  @@index([lenderOrgId])
  @@map("broker_lender_access")
}

model BrokerLenderInvite {
  id          String       @id @default(uuid()) @db.Uuid
  lenderOrgId String       @db.Uuid
  brokerOrgId String       @db.Uuid
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  lender Organization @relation("BrokerInvite_lender", fields: [lenderOrgId], references: [id])
  broker Organization @relation("BrokerInvite_broker", fields: [brokerOrgId], references: [id])

  @@unique([lenderOrgId, brokerOrgId])
  @@index([lenderOrgId])
  @@index([brokerOrgId])
  @@map("broker_lender_invites")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model EligibilityRuleSet {
  id                         String                      @id @default(uuid()) @db.Uuid
  lenderProductId            String                      @db.Uuid
  name                       String
  description                String?
  effectiveFrom              DateTime?
  effectiveTo                DateTime?
  isActive                   Boolean                     @default(true)
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz(6)
  applicationRuleEvaluations ApplicationRuleEvaluation[]
  lenderProduct              LenderProduct               @relation(fields: [lenderProductId], references: [id])
  rules                      EligibilityRule[]

  @@index([lenderProductId])
  @@map("eligibility_rule_sets")
}

model EligibilityRule {
  id                     String                  @id @default(uuid()) @db.Uuid
  ruleSetId              String                  @db.Uuid
  fieldName              String
  comparisonOperator     RuleComparisonOperator
  value                  String
  severity               RuleSeverity
  message                String?
  sortOrder              Int?
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  applicationRuleResults ApplicationRuleResult[]
  ruleSet                EligibilityRuleSet      @relation(fields: [ruleSetId], references: [id])

  @@index([ruleSetId])
  @@map("eligibility_rules")
}

model DocumentType {
  id                      String                           @id @default(uuid()) @db.Uuid
  name                    String
  code                    String
  description             String?
  isActive                Boolean                          @default(true)
  createdAt               DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                         @updatedAt @db.Timestamptz(6)
  applicationRequirements ApplicationDocumentRequirement[]
  lenderRequirements      LenderDocumentRequirement[]
  productRequirements     ProductDocumentRequirement[]
  lenderDocumentRequests  LenderDocumentRequest[]

  @@map("document_types")
}

model ProductDocumentRequirement {
  id              String          @id @default(uuid()) @db.Uuid
  loanProductId   String?         @db.Uuid
  loanProductCode LoanProductCode
  documentTypeId  String          @db.Uuid
  isRequired      Boolean         @default(true)
  minFiles        Int?            @default(1)
  maxFiles        Int?
  notes           String?
  sortOrder       Int?
  createdAt       DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(6)
  documentType    DocumentType    @relation(fields: [documentTypeId], references: [id])
  loanProduct     LoanProduct?    @relation(fields: [loanProductId], references: [id])

  @@index([documentTypeId])
  @@index([loanProductCode])
  @@index([loanProductId])
  @@map("product_document_requirements")
}

model LenderDocumentRequirement {
  id              String        @id @default(uuid()) @db.Uuid
  lenderProductId String        @db.Uuid
  documentTypeId  String        @db.Uuid
  isRequired      Boolean       @default(true)
  minFiles        Int?          @default(1)
  maxFiles        Int?
  notes           String?
  sortOrder       Int?
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)
  documentType    DocumentType  @relation(fields: [documentTypeId], references: [id])
  lenderProduct   LenderProduct @relation(fields: [lenderProductId], references: [id])

  @@index([lenderProductId])
  @@index([documentTypeId])
  @@map("lender_document_requirements")
}

model LenderDocumentRequest {
  id String @id @default(uuid()) @db.Uuid

  loanApplicationId   String @db.Uuid
  applicationLenderId String @db.Uuid
  documentTypeId      String @db.Uuid

  status DocRequirementStatus @default(PENDING)

  requestedAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  // relations
  loanApplication   LoanApplication   @relation(fields: [loanApplicationId], references: [id])
  applicationLender ApplicationLender @relation(fields: [applicationLenderId], references: [id])
  documentType      DocumentType      @relation(fields: [documentTypeId], references: [id])

  @@unique([applicationLenderId, documentTypeId])
  @@index([loanApplicationId])
  @@index([applicationLenderId])
  @@index([documentTypeId])
  @@map("lender_document_requests")
}

model BrokerWhiteLabelSetting {
  id          String @id @default(uuid()) @db.Uuid
  brokerOrgId String @unique @db.Uuid

  // DOMAIN CONFIG
  platformSubdomain String? @unique
  customDomain      String? @unique
  domainVerified    Boolean @default(false)
  sslStatus         String? // PENDING | ISSUED | FAILED

  // BRANDING / THEME
  brandName      String?
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String?
  secondaryColor String?
  fontFamily     String?

  // UI / COPY
  footerText   String?
  supportEmail String?

  // WHITE-LABEL FLAGS
  fullWhiteLabel            Boolean @default(false) // hides platform branding
  showBrokerBrandOnApproval Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  broker Organization @relation(fields: [brokerOrgId], references: [id])

  @@index([brokerOrgId])
  @@map("broker_white_label_settings")
}

model AffiliateLink {
  id              String                  @id @default(uuid()) @db.Uuid
  brokerOrgId     String                  @db.Uuid
  code            String                  @unique
  targetType      AffiliateTargetType
  commissionType  AffiliateCommissionType
  commissionValue Decimal?                @db.Decimal(12, 2)
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(6)
  broker          Organization            @relation(fields: [brokerOrgId], references: [id])

  @@index([brokerOrgId])
  @@map("affiliate_links")
}

model LoanApplication {
  id                     String                           @id @default(uuid()) @db.Uuid
  applicationNumber      String                           @unique
  brokerOrgId            String                           @db.Uuid
  brokerUserId           String?                          @db.Uuid
  clientId               String                           @db.Uuid
  loanProductCode        LoanProductCode
  status                 LoanApplicationStatus            @default(DRAFT)
  amountRequested        Decimal?                         @db.Decimal(20, 2)
  termMonthsRequested    Int?
  purpose                String?
  createdAt              DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                         @updatedAt @db.Timestamptz(6)
  submittedAt            DateTime?                        @db.Timestamptz(6)
  collaterals            ApplicationCollateral[]
  documentRequirements   ApplicationDocumentRequirement[]
  documentUploads        ApplicationDocumentUpload[]
  lenderDocumentRequests LenderDocumentRequest[]
  financials             ApplicationFinancial?
  applicationLenders     ApplicationLender[]
  ruleEvaluations        ApplicationRuleEvaluation[]
  statusHistory          ApplicationStatusHistory[]
  escrowInstructions     EscrowInstruction[]
  brokerOrg              Organization                     @relation("BrokerLoanApplications", fields: [brokerOrgId], references: [id])
  brokerUser             UserAccount?                     @relation("BrokerUserLoanApplications", fields: [brokerUserId], references: [id])
  client                 Client                           @relation(fields: [clientId], references: [id])
  submissions            ApplicationSubmission[]
  clientUploadTokens     ClientUploadToken[]

  @@index([brokerOrgId])
  @@index([clientId])
  @@index([loanProductCode])
  @@map("loan_applications")
}

model BrokerApplication {
  id          String  @id @default(uuid()) @db.Uuid
  brokerOrgId String  @db.Uuid
  name        String
  code        String? @unique
  isActive    Boolean @default(false)

  createdFromTemplate Boolean  @default(false)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)

  products BrokerApplicationProduct[]

  broker Organization @relation(fields: [brokerOrgId], references: [id])

  @@index([brokerOrgId])
  @@map("broker_applications")
}

model BrokerApplicationProduct {
  id                  String                          @id @default(uuid()) @db.Uuid
  brokerApplicationId String                          @db.Uuid
  loanProductCode     LoanProductCode
  isActive            Boolean                         @default(true)
  sections            BrokerApplicationSection[]
  fields              BrokerApplicationProductField[]

  brokerApplication BrokerApplication @relation(fields: [brokerApplicationId], references: [id])

  @@unique([brokerApplicationId, loanProductCode])
  @@index([loanProductCode])
  @@map("broker_application_products")
}

model BrokerApplicationProductField {
  id                   String @id @default(uuid()) @db.Uuid
  applicationProductId String @db.Uuid

  fieldKey    String
  label       String
  placeholder String?
  fieldType   FieldType
  isRequired  Boolean                   @default(false)
  sectionId   String?                   @db.Uuid
  section     BrokerApplicationSection? @relation(fields: [sectionId], references: [id])
  options     Json?
  validation  Json?
  sortOrder   Int?

  submissions ApplicationSubmissionField[]

  applicationProduct BrokerApplicationProduct @relation(fields: [applicationProductId], references: [id])

  @@index([applicationProductId])
  @@map("broker_application_product_fields")
}

model BrokerApplicationSection {
  id                   String @id @default(uuid()) @db.Uuid
  applicationProductId String @db.Uuid

  name        String
  description String?
  sortOrder   Int
  isActive    Boolean @default(true)

  fields BrokerApplicationProductField[]

  applicationProduct BrokerApplicationProduct @relation(fields: [applicationProductId], references: [id])

  @@unique([applicationProductId, name])
  @@index([applicationProductId])
  @@map("broker_application_sections")
}

model LoanApplicationField {
  id              String          @id @default(uuid()) @db.Uuid
  loanProductCode LoanProductCode
  fieldKey        String // e.g. "annualRevenue"
  label           String // "Annual Revenue"
  fieldType       FieldType
  isRequired      Boolean         @default(false)
  options         Json? // for dropdowns
  validation      Json? // min, max, regex
  sortOrder       Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([loanProductCode])
  @@map("loan_application_fields")
}

model ApplicationFinancial {
  id                String          @id @default(uuid()) @db.Uuid
  loanApplicationId String          @unique @db.Uuid
  annualRevenue     Decimal?        @db.Decimal(20, 2)
  netIncome         Decimal?        @db.Decimal(20, 2)
  ebitda            Decimal?        @db.Decimal(20, 2)
  totalDebt         Decimal?        @db.Decimal(20, 2)
  dscr              Decimal?        @db.Decimal(10, 4)
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)
  loanApplication   LoanApplication @relation(fields: [loanApplicationId], references: [id])

  @@index([loanApplicationId])
  @@map("application_financials")
}

model ApplicationCollateral {
  id                String          @id @default(uuid()) @db.Uuid
  loanApplicationId String          @db.Uuid
  collateralType    String
  description       String?
  valueEstimated    Decimal?        @db.Decimal(20, 2)
  lienPosition      String?
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)
  loanApplication   LoanApplication @relation(fields: [loanApplicationId], references: [id])

  @@index([loanApplicationId])
  @@map("application_collaterals")
}

model ApplicationDocumentRequirement {
  id                String                      @id @default(uuid()) @db.Uuid
  loanApplicationId String                      @db.Uuid
  documentTypeId    String                      @db.Uuid
  source            DocRequirementSource
  isRequired        Boolean                     @default(true)
  status            DocRequirementStatus        @default(PENDING)
  lastRequestedAt   DateTime?                   @db.Timestamptz(6)
  createdAt         DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                    @updatedAt @db.Timestamptz(6)
  documentType      DocumentType                @relation(fields: [documentTypeId], references: [id])
  loanApplication   LoanApplication             @relation(fields: [loanApplicationId], references: [id])
  uploads           ApplicationDocumentUpload[]

  @@index([loanApplicationId])
  @@index([documentTypeId])
  @@map("application_document_requirements")
}

model ApplicationDocumentUpload {
  id                     String  @id @default(uuid()) @db.Uuid
  loanApplicationId      String  @db.Uuid
  documentRequirementId  String? @db.Uuid
  uploadedByUserId       String? @db.Uuid
  uploadedByClientUserId String? @db.Uuid
  fileName               String
  fileUrl                String
  fileMimeType           String?

  isSubmittedToLender  Boolean                         @default(false)
  submittedAt          DateTime?                       @db.Timestamptz(6)
  documentSubmissions  ApplicationDocumentSubmission[]
  uploadedAt           DateTime                        @default(now()) @db.Timestamptz(6)
  documentRequirement  ApplicationDocumentRequirement? @relation(fields: [documentRequirementId], references: [id])
  loanApplication      LoanApplication                 @relation(fields: [loanApplicationId], references: [id])
  uploadedByClientUser ClientPortalUser?               @relation("UploadedByClient", fields: [uploadedByClientUserId], references: [id])
  uploadedByUser       UserAccount?                    @relation("UploadedByUser", fields: [uploadedByUserId], references: [id])

  @@index([loanApplicationId])
  @@index([documentRequirementId])
  @@map("application_document_uploads")
}

model ApplicationDocumentSubmission {
  id String @id @default(uuid()) @db.Uuid

  documentUploadId    String @db.Uuid
  applicationLenderId String @db.Uuid

  submittedAt DateTime @default(now()) @db.Timestamptz(6)

  documentUpload    ApplicationDocumentUpload @relation(fields: [documentUploadId], references: [id])
  applicationLender ApplicationLender         @relation(fields: [applicationLenderId], references: [id])

  @@unique([documentUploadId, applicationLenderId])
  @@index([documentUploadId])
  @@index([applicationLenderId])
  @@map("application_document_submissions")
}

model ApplicationRuleEvaluation {
  id String @id @default(uuid()) @db.Uuid

  loanApplicationId String  @db.Uuid
  submissionId      String  @db.Uuid
  ruleSetId         String? @db.Uuid

  result      String
  evaluatedAt DateTime @default(now()) @db.Timestamptz(6)

  loanApplication LoanApplication @relation(fields: [loanApplicationId], references: [id])

  submission ApplicationSubmission @relation(fields: [submissionId], references: [id])

