/// Dedicated Agency GHL sub-account for a broker organization (1 org = 1 location).
/// Separate from OrganizationGhlConnection (broker OAuth / CRM).
/// Created under the platform Agency via Private Integration; never a shared Pro/Elite pool.
model OrganizationGhlAgencyLocation {
  id             String                                @id @default(uuid()) @db.Uuid
  organizationId String                                @unique @db.Uuid
  /// Plan that determined this mapping: PRO | ELITE (BASIC clears to INACTIVE).
  packageCode    String
  ghlCompanyId   String
  ghlLocationId  String
  status         OrganizationGhlAgencyLocationStatus   @default(ACTIVE)
  lastError      String?
  assignedAt     DateTime?                             @db.Timestamptz(6)
  createdAt      DateTime                              @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                              @updatedAt @db.Timestamptz(6)
  organization   Organization                          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([ghlLocationId])
  @@index([status])
  @@index([packageCode])
  @@map("organization_ghl_agency_locations")
}

enum OrganizationGhlAgencyUserStatus {
  PENDING
  ACTIVE
  INACTIVE
  ERROR
}

/// LendingCart UserAccount ↔ Agency GHL team-user mapping.
/// Used by read-only reconciliation and by Agency team-user provisioning.
/// Separate from OrganizationGhlAgencyLocation (org→location) and OrganizationGhlConnection (OAuth).
model OrganizationGhlAgencyUser {
  id             String                            @id @default(uuid()) @db.Uuid
  organizationId String                            @db.Uuid
  userId         String                            @unique @db.Uuid
  ghlUserId      String                            @unique
  ghlLocationId  String
  email          String
  status         OrganizationGhlAgencyUserStatus   @default(PENDING)
  lastError      String?
  matchedAt      DateTime?                         @db.Timestamptz(6)
  createdAt      DateTime                          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                          @updatedAt @db.Timestamptz(6)
  organization   Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           UserAccount                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([ghlLocationId])
  @@index([email])
  @@index([status])
  @@map("organization_ghl_agency_users")
}

/// Per-broker GoHighLevel OAuth connection (CRM integration — separate from platform GHL_API_KEY billing).
model OrganizationGhlConnection {
  id                String                            @id @default(uuid()) @db.Uuid
  organizationId    String                            @unique @db.Uuid
  ghlLocationId     String                            @unique
  ghlCompanyId      String?
  /// AES-256-GCM encrypted access token (see utils/security/secretEncryption.js).
  accessToken       String
  /// AES-256-GCM encrypted refresh token.
  refreshToken      String?
  tokenExpiresAt    DateTime?                         @db.Timestamptz(6)
  scopes            String[]                          @default([])
  connectedAt       DateTime?                         @db.Timestamptz(6)
  connectedByUserId String?                           @db.Uuid
  status            OrganizationGhlConnectionStatus   @default(CONNECTED)
  lastError         String?
  createdAt         DateTime                          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                          @updatedAt @db.Timestamptz(6)
  organization      Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy       UserAccount?                      @relation("GhlConnectionConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)

  @@index([ghlLocationId])
  @@index([status])
  @@index([connectedByUserId])
  @@index([tokenExpiresAt])
  @@map("organization_ghl_connections")
}

