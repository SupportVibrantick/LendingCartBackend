model EmailOutbox {
  id              String              @id @default(uuid()) @db.Uuid
  to              String
  cc              String?
  bcc             String?
  subject         String
  text            String?
  html            String?
  templateKey     String?
  templateData    Json?
  provider        EmailOutboxProvider @default(SMTP)
  providerMeta    Json?
  status          EmailOutboxStatus   @default(PENDING)
  attempts        Int                 @default(0)
  maxAttempts     Int                 @default(5)
  nextAttemptAt   DateTime            @default(now()) @db.Timestamptz(6)
  lockedBy        String?
  lockedUntil     DateTime?           @db.Timestamptz(6)
  idempotencyKey  String?             @unique
  lastError       String?
  sentAt          DateTime?           @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@map("email_outbox")
}

model JobLock {
  name        String    @id
  lockedBy    String?
  lockedUntil DateTime? @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  @@map("job_locks")
}
