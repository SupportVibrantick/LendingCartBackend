PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:password@localhost:5432/lendingcart_new

JWT_SECRET=change-me
JWT_EXPIRATION=24h

FRONTEND_URL=http://localhost:5173
EMBED_APP_URL=http://localhost:5175

# HTTP / socket CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175
SOCKET_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

# Workers (API process should keep ENABLE_CRONS=false)
ENABLE_CRONS=false
WORKER_ID=local-worker-1

# Email
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# Optional queue
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_EMAIL_TOPIC=email-sending

# Optional GHL
GHL_ENABLED=false
GHL_WEBHOOK_URL=

# Optional Redis (multi-instance Socket.IO)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
