PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:password@localhost:5432/lendingcart_new

JWT_SECRET=change-me
JWT_EXPIRATION=24h

FRONTEND_URL=http://localhost:5173
EMBED_APP_URL=http://localhost:5175

# HTTP / socket CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175
SOCKET_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175
# Loan AI marketing site (checkout return URL allowlist)
LOAN_AI_URL=http://localhost:5173

# Workers (API process should keep ENABLE_CRONS=false)
ENABLE_CRONS=false
WORKER_ID=local-worker-1

# Email
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# Optional queue
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_EMAIL_TOPIC=email-sending

# Optional GHL
GHL_ENABLED=true
GHL_WEBHOOK_URL=
# Prefer for Book Demo contact upsert (Lead Connector API)
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_API_BASE_URL=
GHL_API_VERSION=
# Optional dedicated lead webhook (falls back to GHL_WEBHOOK_URL)
GHL_LEAD_WEBHOOK_URL=
# Optional GHL custom field IDs for contact upsert
GHL_CF_LEAD_SOURCE=
GHL_CF_LEAD_TYPE=
GHL_CF_INTERESTED_PLAN=
GHL_CF_LEAD_ID=

# GHL Product + Price IDs (subscription checkout mapping; server-side only)
GHL_PRODUCT_ID=

# Basic
GHL_BASIC_MONTHLY_PRICE_ID=
GHL_BASIC_YEARLY_PRICE_ID=

# Pro
GHL_PRO_MONTHLY_PRICE_ID=
GHL_PRO_YEARLY_PRICE_ID=

# Elite
GHL_ELITE_MONTHLY_PRICE_ID=
GHL_ELITE_YEARLY_PRICE_ID=

# GHL invoice/payment mode (Stripe via GHL Payments)
# true  = LIVE mode (production — real charges)
# false = TEST mode (local/staging only — Stripe test cards)
# Missing/empty defaults to true for production safety.
GHL_PAYMENTS_LIVE_MODE=true

# Invoice send identity (GHL requires userId OR sentFrom)
# Prefer setting at least one; otherwise backend tries to pick a location user.
# GHL_USER_ID=
# GHL_SENT_FROM_EMAIL=billing@yourdomain.com
# GHL_SENT_FROM_NAME=LendingCart
# GHL_BUSINESS_NAME=LendingCart

# Inbound GHL webhooks (POST /api/webhooks/ghl)
# Prefer official X-GHL-Signature / X-WH-Signature verification.
# Optional shared secret for workflow/custom webhooks:
GHL_INBOUND_WEBHOOK_SECRET=GHL_LendingCart_8f4c2a91d7e63b50a6c9f128e4b7d305
# Optional PEM overrides if GHL rotates keys (use \n for newlines):
# GHL_WEBHOOK_ED25519_PUBLIC_KEY=
# GHL_WEBHOOK_RSA_PUBLIC_KEY=
# Dev only — never enable in production:
# GHL_WEBHOOK_SKIP_VERIFY=false

# Optional Redis (multi-instance Socket.IO)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
