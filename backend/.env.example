PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:password@localhost:5432/lendingcart_new

JWT_SECRET=change-me
JWT_EXPIRATION=24h

FRONTEND_URL=http://localhost:5173
EMBED_APP_URL=http://localhost:5175

# HTTP / socket CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175
SOCKET_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175
# Production example (also set on VPS backend/.env):
# SOCKET_CORS_ORIGINS=https://broker-lendingcart.vibrantick.org,https://lender-lendingcart.vibrantick.org,https://admin-lendingcart.vibrantick.org,https://loan-application-lendingcart.vibrantick.org,https://embed-lendingcart.vibrantick.org
# Allow any https/http subdomain (broker-*, lender-*, etc.) when explicit list is incomplete:
SOCKET_CORS_DOMAIN_SUFFIX=vibrantick.org
# Loan AI marketing site (checkout return URL allowlist)
LOAN_AI_URL=http://localhost:5173

# Workers (API process should keep ENABLE_CRONS=false)
ENABLE_CRONS=false
WORKER_ID=local-worker-1

# Email
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# Optional queue
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_EMAIL_TOPIC=email-sending

# Optional GHL
GHL_ENABLED=true
GHL_WEBHOOK_URL=
# Prefer for Book Demo contact upsert (Lead Connector API)
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_API_BASE_URL=
GHL_API_VERSION=
# Optional dedicated lead webhook (falls back to GHL_WEBHOOK_URL)
GHL_LEAD_WEBHOOK_URL=
# Optional GHL custom field IDs for contact upsert
GHL_CF_LEAD_SOURCE=
GHL_CF_LEAD_TYPE=
GHL_CF_INTERESTED_PLAN=
GHL_CF_LEAD_ID=

# GHL Product + Price IDs (subscription checkout mapping; server-side only)
GHL_PRODUCT_ID=
GHL_WEBHOOK_PAYLOAD_DEBUG=false

# Basic
GHL_BASIC_MONTHLY_PRICE_ID=
GHL_BASIC_YEARLY_PRICE_ID=

# Pro
GHL_PRO_MONTHLY_PRICE_ID=
GHL_PRO_YEARLY_PRICE_ID=

# Elite
GHL_ELITE_MONTHLY_PRICE_ID=
GHL_ELITE_YEARLY_PRICE_ID=

# GHL invoice/payment mode (Stripe via GHL Payments)
# true  = LIVE mode (production — real charges)
# false = TEST mode (local/staging only — Stripe test cards)
# Missing/empty defaults to true for production safety.
GHL_PAYMENTS_LIVE_MODE=true

# Invoice send identity (GHL requires userId OR sentFrom)
# Prefer setting at least one; otherwise backend tries to pick a location user.
# GHL_USER_ID=
# GHL_SENT_FROM_EMAIL=billing@yourdomain.com
# GHL_SENT_FROM_NAME=LendingCart
# GHL_BUSINESS_NAME=LendingCart

# Inbound GHL webhooks (POST /api/webhooks/ghl)
# Prefer official X-GHL-Signature / X-WH-Signature verification.
# Optional shared secret for workflow/custom webhooks:
GHL_INBOUND_WEBHOOK_SECRET=GHL_LendingCart_8f4c2a91d7e63b50a6c9f128e4b7d305

# Agency-level Private Integration (server-only — never expose to frontend)
# Scopes: locations.readonly, locations.write, users.readonly, users.write
GHL_AGENCY_PRIVATE_TOKEN=
# Agency company ID (required to create sub-accounts under the client agency)
GHL_AGENCY_COMPANY_ID=
# White-label GHL app URL used for broker "Open CRM" links and login emails
# Example: https://app.commerciallendingmastery.com
GHL_AGENCY_APP_BASE_URL=https://app.gohighlevel.com
# Optional Account Snapshot IDs applied when creating a dedicated Pro/Elite sub-account
GHL_PRO_SNAPSHOT_ID=
GHL_ELITE_SNAPSHOT_ID=
# Legacy shared Pro/Elite pool location IDs — NOT used to map new orgs.
# Kept only so existing pool mappings can be detected and replaced with dedicated locations.
# GHL_PRO_LOCATION_ID=
# GHL_ELITE_LOCATION_ID=

# Broker-owned GHL OAuth (CRM integration — separate from platform GHL_API_KEY billing)
GHL_OAUTH_CLIENT_ID=
GHL_OAUTH_CLIENT_SECRET=
GHL_OAUTH_REDIRECT_URI=http://localhost:4000/broker/integrations/oauth/callback
GHL_OAUTH_APP_VERSION_ID=
# 32-byte key as hex (64 chars) or base64 — encrypts stored OAuth tokens at rest
GHL_OAUTH_TOKEN_ENCRYPTION_KEY=
# Marketplace app version ID (included in authorization URL as &version_id=)
# GHL_OAUTH_APP_VERSION_ID=
# Optional overrides
# GHL_OAUTH_AUTHORIZE_URL=https://marketplace.gohighlevel.com/oauth/chooselocation
# GHL_OAUTH_TOKEN_URL=https://services.leadconnectorhq.com/oauth/token
# GHL_OAUTH_SCOPES=funnels/funnel.readonly funnels/page.readonly funnels/pagecount.readonly
# Broker dashboard origin used for OAuth callback redirect (falls back to FRONTEND_URL)
# BROKER_DASHBOARD_URL=http://localhost:5174
# Optional PEM overrides if GHL rotates keys (use \n for newlines):
# GHL_WEBHOOK_ED25519_PUBLIC_KEY=
# GHL_WEBHOOK_RSA_PUBLIC_KEY=
# Dev only — never enable in production:
# GHL_WEBHOOK_SKIP_VERIFY=false
# Temporary: log masked GHL webhook payload structure (keys + field paths)
# GHL_WEBHOOK_PAYLOAD_DEBUG=true

# Optional Redis (multi-instance Socket.IO)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Sign-form AI / OCR assist (Phase 4) — all optional
# AcroForm extraction always runs for PDFs (no API key).
# Free OCR (default ON): PDF text positions via pdf.js + Tesseract for images.
# Azure Document Intelligence is optional paid/cloud layout assist.
# LLM refine improves labels/types only (never invents coordinates).
# ---------------------------------------------------------------------------
# Free OCR (no cloud key). Set false to disable.
SIGN_FORM_FREE_OCR=true
SIGN_FORM_TESSERACT=true
SIGN_FORM_TESSERACT_LANG=eng
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com
# AZURE_DOCUMENT_INTELLIGENCE_KEY=
# AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
# AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-layout
# Legacy aliases also supported:
# AZURE_FORM_RECOGNIZER_ENDPOINT=
# AZURE_FORM_RECOGNIZER_KEY=
# SIGN_FORM_LLM_API_KEY=          # or OPENAI_API_KEY
# SIGN_FORM_LLM_BASE_URL=https://api.openai.com/v1
# SIGN_FORM_LLM_MODEL=gpt-4o-mini
# Documents sent to Azure/OpenAI leave this server. Do not enable OCR/LLM for
# restricted forms unless your data-processing agreement covers it.

# Sign-form production limits (Phase 5)
# UPLOAD_MAX_BYTES=26214400
# SIGN_FORM_MAX_PAGES=20
# SIGN_FORM_MAX_FIELDS=150
# SIGN_FORM_MAX_CONDITIONALS=40
# SIGN_FORM_MAX_TABLES=8
# Template files are stored under uploads/sign-form-library/{orgId}/
# Archive unused templates from the lender library; files are retained on disk.
